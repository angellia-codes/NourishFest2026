# Deployed GAS Web App URL, ending in /exec
# Apps Script editor > Deploy > Manage deployments > copy "Web app" URL
VITE_GAS_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec

# Google OAuth Client ID for the Sign-In button (Google Cloud Console >
# APIs & Services > Credentials). Must match GOOGLE_CLIENT_ID in Code.gs.
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com